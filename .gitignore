# ------------------------------------
# 1. Virtual environments and package management
# ------------------------------------

# Virtual environment directories (commonly used names)
.venv
venv
env
/venv/
/env/
/bin/
/include/
/lib/
/lib64/

# pip cache and log files
pip-log.txt
.pip_log

# Python package management files
# If you use Poetry, delete the next line and commit the lock file.
poetry.lock

# Pipenv files (the lock file should normally be committed)
Pipfile.lock

# Conda environment directories
.conda

# ------------------------------------
# 2. Bytecode and temporary files
# ------------------------------------

# Python bytecode files
*.pyc
__pycache__/
*.pyd
*.whl

# Temporary files of C/C++ extension modules
*.so
*.o
*.dll

# dist/build/egg/ and the like (packaging related)
dist/
build/
*.egg-info/
.eggs/

# ------------------------------------
# 3. Tests and documentation
# ------------------------------------

# Test coverage files
.coverage
.tox/

# Build files of Sphinx documentation
/docs/_build/

