# ------------------------------------

# macOS
.DS_Store

# Vim
*~

# VS Code settings
.vscode/

# JetBrains IDEs (PyCharm, IntelliJ IDEA and so on)
.idea/

# Database files
*.sqlite3
db.sqlite3

# Log files
*.log
/logs/

# Environment variables and secrets
.env
.flaskenv

# MY APP
/var/tmp/
*.iml

# Whisper model cache
.cache/whisper/

# Input and output files (binaries, generated artifacts)
/input/*
!/input/.gitkeep
/output/*
!/output/.gitkeep
frames_tmp*/

